  "components": [
    {
      "name": "Primary installation action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid primary action; night theme reverses its contrast.",
      "html": "<button class=\"ds-button ds-primary\">Get Nightfall</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:11px 22px;border:1px solid var(--field-border,#a6b9bd);border-radius:9px;font:550 15px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background-color 180ms,transform 180ms,border-color 180ms}.ds-button:hover{transform:translateY(-1px)}.ds-button:active{transform:translateY(1px) scale(.985)}.ds-button:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--button,#0c443b);color:var(--on-button,#fffef6);border-color:var(--button,#0c443b);min-width:196px}.ds-primary:hover{background:var(--button-hover,#175a4e);border-color:var(--button-hover,#175a4e)}"
    },
    {
      "name": "Secondary installation action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Translucent secondary installation choice.",
      "html": "<button class=\"ds-button ds-secondary\">Install on Linux</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:11px 22px;border:1px solid var(--field-border,#a6b9bd);border-radius:9px;font:550 15px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background-color 180ms,transform 180ms,border-color 180ms}.ds-button:hover{transform:translateY(-1px)}.ds-button:active{transform:translateY(1px) scale(.985)}.ds-button:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:#ffffff30;border-color:#526b7880;color:var(--ink,#0a2634);min-width:196px}.ds-secondary:hover{background:#ffffff60}"
    },
    {
      "name": "Utility action",
      "kind": "button",
      "refersTo": "button-utility",
      "description": "Field-colored command-copy or dialog utility control.",
      "html": "<button class=\"ds-button ds-utility\">Copy commands</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:11px 22px;border:1px solid var(--field-border,#a6b9bd);border-radius:9px;font:550 15px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background-color 180ms,transform 180ms,border-color 180ms}.ds-button:hover{transform:translateY(-1px)}.ds-button:active{transform:translateY(1px) scale(.985)}.ds-button:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-utility{background:var(--field,#e9f0ee);color:var(--ink,#0a2634);min-height:44px;padding:8px 12px}.ds-utility:hover{background:var(--field-hover,#d9e7e4)}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Circular pause control with a visible focus ring.",
      "html": "<button class=\"ds-icon\" aria-label=\"Pause snowfall\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"14\" y=\"3\" width=\"4\" height=\"18\" rx=\"1\"/><rect x=\"6\" y=\"3\" width=\"4\" height=\"18\" rx=\"1\"/></svg></button>",
      "css": ".ds-icon{display:grid;place-items:center;min-width:44px;height:44px;padding:0;background:transparent;color:var(--ink,#0a2634);border:1px solid transparent;border-radius:50%;cursor:pointer;transition:background 180ms,transform 180ms}.ds-icon:hover{background:#ffffff30;transform:translateY(-1px)}.ds-icon:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}"
    },
    {
      "name": "Navigation link",
      "kind": "nav",
      "description": "Readable link with an understated hover underline.",
      "html": "<a class=\"ds-nav\" href=\"https://github.com/romeirofernandes/nightfall\">GitHub</a>",
      "css": ".ds-nav{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;font:400 14px/1.55 Figtree,system-ui,sans-serif;color:var(--ink,#0a2634);text-decoration:none}.ds-nav:hover{text-decoration:underline;text-underline-offset:5px}.ds-nav:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}"
    },
    {
      "name": "Time selector",
      "kind": "custom",
      "refersTo": "time-switch",
      "description": "Named phase choices with a filled selected state; preview shows the desktop control.",
      "html": "<fieldset class=\"ds-time\"><legend class=\"ds-hidden\">Choose the time of day</legend><button aria-pressed=\"true\">Auto</button><button aria-pressed=\"false\">Morning</button><button aria-pressed=\"false\">Afternoon</button><button aria-pressed=\"false\">Evening</button><button aria-pressed=\"false\">Night</button></fieldset>",
      "css": ".ds-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-time{display:flex;align-items:center;gap:4px;margin:0;padding:5px;border:1px solid #ffffff90;border-radius:14px;background:#f8f7efd9;color:#153e3d;box-shadow:0 6px 24px #0a233d29;backdrop-filter:blur(14px)}.ds-time button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 18px;border:1px solid transparent;border-radius:9px;background:transparent;color:inherit;font:400 13px/1.55 Figtree,system-ui,sans-serif;cursor:pointer;transition:background 180ms,transform 180ms}.ds-time button:hover{background:#b9ccc659;transform:translateY(-1px)}.ds-time button:active{transform:translateY(1px)}.ds-time button[aria-pressed=\"true\"]{background:#133e37;color:#fffdf0}.ds-time button:focus-visible{outline:2px solid #153e3d;outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-time button{transition:none}}"
    },
    {
      "name": "Installation terminal",
      "kind": "custom",
      "refersTo": "terminal",
      "description": "Bordered wrapping command surface, with a focusable command region.",
      "html": "<div class=\"ds-terminal\"><div class=\"ds-terminal-bar\">Homebrew</div><pre tabindex=\"0\" aria-label=\"Installation commands\"><code>brew tap --custom-remote romeirofernandes/nightfall https://github.com/romeirofernandes/nightfall\nbrew update-reset &quot;$(brew --repository romeirofernandes/nightfall)&quot;\nbrew install --cask romeirofernandes/nightfall/nightfall</code></pre></div>",
      "css": ".ds-terminal{border:1px solid var(--line,#b7c8cc);border-radius:9px;background:var(--background,#eef4f8);color:var(--ink,#0a2634);overflow:hidden}.ds-terminal-bar{padding:8px 12px;border-bottom:1px solid var(--line,#b7c8cc);color:var(--muted,#334e5b);font:400 14px/1.55 Figtree,system-ui,sans-serif}.ds-terminal pre{margin:0;padding:18px;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.7 ui-monospace,monospace}.ds-terminal pre:focus-visible{outline:2px solid var(--accent,#226653);outline-offset:5px}"
    }
  ],
  "narrative": {
    "northStar": "The Same Winter, Lit Four Ways",
    "overview": "A detailed, softly illustrated alpine winter is the visual world: snowy mountains, pines, a snowman and small warm Christmas lights. Expressive Prata headlines sit in quiet sky, while Figtree keeps the product explanation, installation controls and time choices readable.\n\nThe same landscape is lit for morning, afternoon, evening and night. Local time provides the starting atmosphere; visitors can choose a phase or return to Auto. The interface is spacious and restrained so the winter scene carries the character.",
    "keyCharacteristics": [
      "Detailed alpine scenery with small warm light accents.",
      "Editorial serif display paired with readable humanist sans controls.",
      "Four clock-based lighting phases with an explicit manual override.",
      "Semantic controls, visible keyboard focus and reduced-motion behavior."
    ],
    "rules": [
      {
        "name": "The Same Winter Rule",
        "body": "Keep the scene and interface coordinated across lighting phases; morning and afternoon share the day plate, while evening and night use their corresponding plates.",
        "section": "colors"
      },
      {
        "name": "The Quiet Sky Rule",
        "body": "Keep the expressive headline and installation controls in readable sky above the detailed scenery.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Let landscape layers carry the scene; reserve interface shadows and blur for the installation dialog and time selector.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the detailed alpine landscape, snowman and warm Christmas lights.",
      "Do use Prata for expressive headings and Figtree for navigation and controls.",
      "Do preserve readable semantic installation actions and keyboard-operable named time controls.",
      "Do keep local-time Auto and persistent manual phase selection available.",
      "Do respect reduced motion and retain the snowman through the right-aligned mobile crop."
    ],
    "donts": [
      "Don't replace the approved detailed illustration with flat cartoon scenery.",
      "Don't let scenery or snow obscure installation controls.",
      "Don't describe the clock-based celestial position as location-based astronomy."
    ]
  }
}
