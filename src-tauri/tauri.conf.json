{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightfall",
  "version": "0.4.1",
  "identifier": "app.nightfall.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A little winter for your desktop",
    "category": "Entertainment",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
